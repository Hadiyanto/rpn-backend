# tools/db-backup — env container pg-backup. Salin ke .env lalu isi. Jangan commit .env.
# Sumber backup (DATABASE_URL) diambil dari DOCKER_DATABASE_URL di rpn-backend/.env (lihat docker-compose.yml).

# Cloudflare R2: bucket PRIVAT khusus backup (mis. rpn-backups), tanpa domain/akses publik.
# Database berisi data customer (nama, nomor WA, alamat) — jangan pernah pakai bucket publik.
# Kosong = backup hanya disimpan lokal di BACKUP_DIR.
R2_BACKUP_BUCKET=
# R2 → Manage R2 API Tokens: token dengan izin Object Read & Write, dibatasi ke bucket di atas.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Opsional: restore setiap backup ke Postgres lain sebagai salinan cadangan (mis. Supabase).
# Supabase -> Project Settings -> Database -> Connection string -> Session pooler (port 5432), tambah ?sslmode=require
SUPABASE_DB_URL=
# true = setiap backup berhasil langsung di-restore ke SUPABASE_DB_URL
RESTORE_TO_SUPABASE=

# Kosong = 3600 (tiap jam)
BACKUP_INTERVAL_SECONDS=
# Kosong = 14 hari (3 backup terbaru selalu disimpan)
BACKUP_KEEP_DAYS=
