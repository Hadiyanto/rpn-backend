# Copy to .env for local development. Production values live in Render — never commit real secrets.
PORT=4000

# Postgres (Supabase pooler connection string). All data access goes through this.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# PG_POOL_MAX=10
# PG_SSL=false            # only for a local Postgres without SSL

# Supabase (only used by the root scripts import_variants.ts / update_roles.ts)
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_KEY

# Upstash Redis (quota counters, WhatsApp session, menu/variant cache)
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# Web push
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:admin@example.com

# Cloudinary (bukti transfer / receipt uploads)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Biteship (delivery)
BITESHIP_KEY=YOUR_BITESHIP_KEY
# Configure the same custom header key and secret in the Biteship webhook dashboard.
BITESHIP_WEBHOOK_HEADER=x-rpn-biteship-secret
BITESHIP_WEBHOOK_SECRET=
# Open deliveries (PENDING/ALLOCATED, booked in the last 24 h) are also polled from Biteship, so a
# "courier not found" reaches admins without the webhook. Minutes between rounds; 0 = off.
# BITESHIP_POLL_MINUTES=3
# BITESHIP_BASE_URL=https://api.biteship.com/v1   # default; a biteship_test_… key = sandbox mode
# Store Delivery (the store ships via Biteship).
#   BITESHIP_ENABLED=false → no Store Delivery: no quotes and no courier booking.
#   BITESHIP_ENABLED=true  → Store Delivery offered to customers whose WhatsApp number is in
#                            BITESHIP_WHITELIST (comma-separated, any format); empty list = everyone.
#   The customer picks a courier from SELECTED_COURIER (comma-separated: grab, gojek, lalamove;
#   empty = all three). The fee is re-quoted by the backend, charged with the order (also on DOKU),
#   and the courier is booked (delivery "now") when the order is set to DONE.
BITESHIP_ENABLED=false
# BITESHIP_WHITELIST=081234567890,6281298765432
# SELECTED_COURIER=grab,gojek,lalamove

# DOKU Checkout (online payment). Credentials: DOKU Back Office → Settings → API Keys.
#   DOKU_PAYMENT=false → current flow: TRANSFER / QRIS / CASH, confirmed via WhatsApp.
#   DOKU_PAYMENT=true  → DOKU replaces QRIS: TRANSFER / DOKU / CASH. Picking DOKU sends the customer
#                        straight to the DOKU checkout page; the order becomes PAID automatically
#                        from DOKU's HTTP notification.
DOKU_PAYMENT=false
DOKU_CLIENT_ID=YOUR_DOKU_CLIENT_ID
DOKU_SECRET_KEY=YOUR_DOKU_SECRET_KEY
# DOKU_URL=https://api-sandbox.doku.com           # production: https://api.doku.com
# DOKU_DEV_BYPASS=true                            # local only: no DOKU call, a DOKU order is PAID at once
#                                                 # (payment_url = /status page). Ignored if NODE_ENV=production.
# DOKU_PAYMENT_DUE_MINUTES=60                    # how long the checkout page stays payable
# DOKU_PAYMENT_METHODS=QRIS                       # channels on the checkout page, comma-separated
                                                  # (e.g. QRIS,VIRTUAL_ACCOUNT_BCA,EMONEY_SHOPEEPAY)
# Notification URL: set https://<backend>/api/payments/doku/notification in DOKU Back Office,
# or set it here to send it with every checkout request (override_notification_url).
# DOKU_NOTIFICATION_URL=https://your-backend.example.com/api/payments/doku/notification

# Bank transfer on the customer order form (default on). false hides it; admin orders keep it.
# TRANSFER_PAYMENT=true

# Own login (docs/plan-lepas-vendor.md §4). AUTH_MODE: off | log | enforce (default enforce):
# off = API not locked, log = would-be 401/403s are logged but served, enforce = locked.
# AUTH_MODE=log
# Production: the API (api.) and frontend share the cookie through the parent domain.
# AUTH_COOKIE_DOMAIN=.rajapisangnugget.com
# Only for plain-http local runs (Secure cookies are dropped on http by Safari):
# AUTH_COOKIE_SECURE=false

# CORS + links sent to customers. CORS_ORIGINS is also the CSRF allow-list for cookie writes.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Docker (docker-compose.yml): database on the shared Postgres network "backend".
# URL-encode special characters in the password (! → %21, @ → %40, # → %23).
DOCKER_DATABASE_URL=postgresql://postgres:<password>@shared-postgres:5432/rpn_db
