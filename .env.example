# Copy to .env for local development. Production values live in Render — never commit real secrets.
PORT=4000

# Postgres (Supabase pooler connection string). All data access goes through this.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# PG_POOL_MAX=10
# PG_SSL=false            # only for a local Postgres without SSL

# Supabase (only used by the root scripts import_variants.ts / update_roles.ts)
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_KEY

# Upstash Redis (quota counters, WhatsApp session, menu/variant cache)
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# Web push
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:admin@example.com

# Cloudinary (bukti transfer / receipt uploads)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Biteship (delivery)
BITESHIP_KEY=YOUR_BITESHIP_KEY
# BITESHIP_BASE_URL=https://api.biteship.com/v1   # default is the sandbox

# CORS + links sent to customers
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
